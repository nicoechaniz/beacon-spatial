#N canvas 100 100 500 400 12;
#X obj 30 30 inlet~ signal;
#X obj 180 30 inlet azimuth;
#X obj 320 30 inlet distance;
#X obj 30 350 outlet~ left;
#X obj 180 350 outlet~ right;
#X obj 180 100 expr sin($f1 * 3.14159 / 180);
#X obj 180 140 t f f f;
#X obj 100 180 expr sqrt((1 - $f1) / 2);
#X obj 260 180 expr sqrt((1 + $f1) / 2);
#X obj 180 180 * 0.65;
#X obj 180 220 moses 0;
#X obj 140 260 * -1;
#X obj 320 100 expr 1 / $f1;
#X obj 100 260 * 1;
#X obj 260 260 * 1;
#X obj 30 120 delwrite~ $0-buf 5;
#X obj 30 260 delread~ $0-buf 0;
#X obj 180 260 delread~ $0-buf 0;
#X obj 30 320 *~;
#X obj 180 320 *~;
#X connect 0 0 15 0;
#X connect 1 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 1 8 0;
#X connect 6 2 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 10 1 16 0;
#X connect 11 0 17 0;
#X connect 2 0 12 0;
#X connect 12 0 13 1;
#X connect 12 0 14 1;
#X connect 7 0 13 0;
#X connect 8 0 14 0;
#X connect 13 0 18 1;
#X connect 14 0 19 1;
#X connect 16 0 18 0;
#X connect 17 0 19 0;
#X connect 18 0 3 0;
#X connect 19 0 4 0;